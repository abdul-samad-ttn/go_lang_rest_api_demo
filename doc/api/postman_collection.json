{
  "info": {
    "name": "Post API (SQLite) — v1",
    "description": "Import into Postman. Set `baseUrl` (default local). Run **Auth / Login (seed alice)** to save `token` for protected requests.\n\nSpec: doc/api/openapi.yaml — plan: doc/PLAN_SQLITE_API_V1.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a1b2c3d4-post-api-v1-local"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password\",\n  \"displayName\": \"New User\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login (seed alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('token', j.token);",
                  "  pm.test('Token saved', () => pm.expect(j.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Seed user 1. Dev password for all seed users: see root README.md (`password`)."
          }
        },
        {
          "name": "GET Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "List posts",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/posts"
          }
        },
        {
          "name": "Get post by id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My post title\",\n  \"body\": \"Post body text\"\n}"
            },
            "url": "{{baseUrl}}/posts"
          }
        },
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "List comments by post",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          }
        },
        {
          "name": "Get comment by id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        },
        {
          "name": "Create comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('commentId', String(j.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Commenter\",\n  \"email\": \"commenter@example.com\",\n  \"body\": \"Comment body\",\n  \"userId\": 1\n}"
            },
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          }
        },
        {
          "name": "Delete comment (author only)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/comments/{{commentId}}?userId=1"
          }
        }
      ]
    }
  ]
}